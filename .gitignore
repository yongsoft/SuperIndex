# ─── secrets ───────────────────────────────────────────────────────────────
# .env holds a real API key. Never commit it; use .env.example as the template.
.env

# ─── vendored upstream engine ──────────────────────────────────────────────
# PageIndex is vendored (not a submodule) so one clone gets a working tree.
# Only the package and the build files are kept; the bulky extras below are
# upstream's own sample material and are not needed to run anything.
# Provenance and the update procedure are in PageIndex/UPSTREAM.md.
PageIndex/.git/
PageIndex/.github/
PageIndex/examples/
PageIndex/assets/
PageIndex/cookbook/
PageIndex/tests/

# ─── document drop zone ────────────────────────────────────────────────────
# data/ is the default document root: every immediate subdirectory becomes a
# corpus automatically. The small Markdown sample corpus ships with the repo so
# a fresh clone is demo-ready; the multi-megabyte source PDFs do not.
#
# Only PDFs are excluded — see the rule below. Add anything else you like here
# and it will be indexed; it will also be committed, so keep private documents
# outside data/ (register them with the UI's directory browser instead).
data/**/*.pdf
data/*.pdf

# ─── central index store ───────────────────────────────────────────────────
# Every tree and index this project builds lives under index/, kept separate
# from the source files it describes (see index/README.md). It is build output:
# reproducible, and it grows with every corpus registered.
index/*
!index/.gitkeep
!index/README.md

# ─── generated outputs ─────────────────────────────────────────────────────
# Everything under results/ is reproducible from the scripts: logs and QA
# result files. Build output, does not belong in git.
results/*
!results/.gitkeep

# ─── local development tooling ─────────────────────────────────────────────
# Local development-tooling state. Not part of the library: it stays on disk
# but out of the repository.
.workbuddy-ai/

# ─── python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ─── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ─── editors ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── misc ──────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# upstream editor/agent config — not needed
PageIndex/.claude/
